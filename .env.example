# Set a random 32+ character URL-safe token before starting the gateway.
GATEWAY_ACCESS_TOKEN=
GATEWAY_WORKSPACE_ID=kantha
# GATEWAY_MEMBERS=[{"actorId":"owner","workspaceId":"kantha","role":"owner","tokenSha256":"<lowercase SHA-256>"}]

# Match the canonical browser origin when deployed behind a proxy.
# GATEWAY_ORIGIN=https://kantha.example.com
GATEWAY_DB_PATH=.gateway-data/gateway.sqlite
# Required for production. Base64 of 32 random bytes.
GATEWAY_SECRET_KEY=

# Optional operator allowlist for explicitly trusted private OpenAI-compatible origins.
# GATEWAY_PRIVATE_ORIGINS=http://127.0.0.1:11434

# Concurrent workload limits for a single gateway process.
# GATEWAY_MAX_ACTIVE_INFERENCE=32
# GATEWAY_MAX_WORKSPACE_INFERENCE=4
# GATEWAY_MAX_ACTIVE_EVENT_STREAMS=128
# GATEWAY_MAX_WORKSPACE_EVENT_STREAMS=12

GATEWAY_MAX_DAILY_TOKENS=200000
# GATEWAY_MODEL_PRICES={"custom:my-model":{"inputPerMillion":1,"outputPerMillion":2}}
# GATEWAY_MAX_DAILY_BUDGET_USD=10

# ---- Upload limits (/api/upload) ------------------------------------------
# Max size per uploaded file in MB (1-50). Defaults to 20.
# UPLOAD_MAX_FILE_SIZE_MB=20
# Max extracted document text length in characters (1000-400000). Defaults to 100000.
# UPLOAD_MAX_TEXT_LENGTH=100000

# Optional static asset origin and local browser metrics, both set at build time.
# CDN_URL=https://static.example.com
# NEXT_PUBLIC_REPORT_WEB_VITALS=1

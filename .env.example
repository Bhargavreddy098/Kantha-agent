# Kantha Environment Configuration
# Modern Local-First Coding Assistant (Zero-Touch Loopback Trust)

# Daemon Port (defaults to 4000)
PORT=4000

# Persistent local data directory for WAL SQLite & session event logs (defaults to .kantha-data)
KANTHA_DATA_DIR=.kantha-data

# Optional: Cloud Model Provider API Keys (or use local Ollama / LM Studio)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

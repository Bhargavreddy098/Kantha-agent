{
  "name": "kantha-agent-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --parallel --filter @kantha/daemon --filter @kantha/web dev",
    "dev:daemon": "pnpm --filter @kantha/daemon dev",
    "dev:web": "pnpm --filter @kantha/web dev",
    "dev:cli": "pnpm --filter @kantha/cli dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.3"
  }
}
